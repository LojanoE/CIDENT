{
  "name": "functions",
  "private": true,
  "version": "0.1.0",
  "description": "CIDENT — Cloud Functions (auth propio, PDFs, adjuntos)",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "node scripts/vendorizarShared.mjs && tsc -p tsconfig.json && node scripts/copiarAssets.mjs",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run test/rules.test.ts\""
  },
  "dependencies": {
    "@cident/shared": "file:vendor/cident-shared",
    "@node-rs/argon2": "^2.0.2",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "pdfkit": "^0.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
