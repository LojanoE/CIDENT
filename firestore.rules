rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function claims()   { return request.auth.token; }
    function signedIn() { return request.auth != null && claims().centroId is string; }
    function esAdmin()  { return signedIn() && claims().rol == 'admin'; }
    function miCentro() { return claims().centroId; }

    function puedeLeer(data) {
      return signedIn() && (esAdmin() || data.centroId == miCentro());
    }
    // Un get() sobre un documento inexistente entrega resource == null; leer
    // ese "no existe" no filtra datos, así que basta con estar autenticado.
    function puedeLeerRecurso(recurso) {
      return recurso == null ? signedIn() : puedeLeer(recurso.data);
    }
    function centroValido(nuevo) {
      return signedIn() && (esAdmin() ? nuevo.centroId is string
                                      : nuevo.centroId == miCentro());
    }
    function noMueveCentro() {
      return request.resource.data.centroId == resource.data.centroId;
    }

    // ---------- Identidad: solo el Admin SDK escribe ----------
    match /users/{uid} {
      // Un profesional ve a sus colegas del mismo centro: la agenda compartida
      // necesita nombrar a quién atiende. En una consulta de lista las rules se
      // evalúan documento por documento, así que el cliente DEBE filtrar por
      // centroId; AdminUsersPage sigue sin filtro porque entra por esAdmin().
      allow read:  if esAdmin()
                   || (request.auth != null && uid == request.auth.uid)
                   || (signedIn() && resource != null && resource.data.centroId == miCentro());
      allow write: if false;
    }
    match /usernames/{u}    { allow read, write: if false; }
    match /counters/{c}     { allow read, write: if false; }
    match /userSecrets/{uid} { allow read, write: if false; }
    match /rateLimits/{id}   { allow read, write: if false; }
    match /auditLogs/{id}   { allow read: if esAdmin(); allow write: if false; }

    match /centros/{centroId} {
      allow read:  if signedIn() && (esAdmin() || centroId == miCentro());
      allow write: if false;

      // Catálogo de tratamientos con precios propios del centro; lo escribe solo el backend.
      match /tratamientos/{id} {
        allow read:  if signedIn() && (esAdmin() || centroId == miCentro());
        allow write: if false;
      }

      // Egresos del centro; los crea y anula solo el backend.
      match /gastos/{id} {
        allow read:  if signedIn() && (esAdmin() || centroId == miCentro());
        allow write: if false;
      }
    }

    match /patientIds/{key} {
      allow read:   if puedeLeerRecurso(resource);
      allow create: if centroValido(request.resource.data)
                    && key == request.resource.data.centroId + '_' + request.resource.data.cedula;
      allow update, delete: if esAdmin();
    }

    match /patients/{patientId} {
      allow read:   if puedeLeerRecurso(resource);
      allow create: if centroValido(request.resource.data);
      allow update: if puedeLeer(resource.data) && noMueveCentro();
      allow delete: if esAdmin();

      match /visits/{visitId} {
        allow read:   if puedeLeerRecurso(resource);
        allow create: if centroValido(request.resource.data)
                      && request.resource.data.estado in ['draft', 'final'];
        // Borrador: se edita y puede finalizarse. Finalizada: solo se puede reabrir
        // (final -> draft tocando únicamente los campos de estado), nunca editarla en
        // sitio. 'anulada' solo la escribe el backend (anularAtencion), no el cliente.
        allow update: if puedeLeer(resource.data) && noMueveCentro()
                      && (
                        (resource.data.estado == 'draft'
                          && request.resource.data.estado in ['draft', 'final'])
                        || (resource.data.estado == 'final'
                          && request.resource.data.estado == 'draft'
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['estado', 'finalizedAt', 'finalizedBy',
                                         'reabiertaAt', 'reabiertaBy']))
                      );
        // El borrado pasa por la callable eliminarAtencion (limpia subcolecciones y agenda).
        allow delete: if false;

        match /detalle/{docId} {
          allow read:   if puedeLeerRecurso(resource);
          allow create: if centroValido(request.resource.data);
          allow update: if puedeLeer(resource.data) && noMueveCentro();
          allow delete: if esAdmin();
        }
      }

      // Documentos generados: solo los crea el backend
      match /prescriptions/{id} { allow read: if puedeLeerRecurso(resource); allow write: if false; }
      match /certificates/{id}  { allow read: if puedeLeerRecurso(resource); allow write: if false; }
      match /attachments/{id}   { allow read: if puedeLeerRecurso(resource); allow write: if false; }
      // Pagos: solo el backend los crea y anula (nunca se borran).
      match /payments/{id}      { allow read: if puedeLeerRecurso(resource); allow write: if false; }

      // Presupuestos: los crea solo el backend. El cliente únicamente puede cambiar el estado
      // (el paciente acepta o rechaza después, incluso con la atención ya finalizada).
      match /budgets/{id} {
        allow read: if puedeLeerRecurso(resource);
        allow create, delete: if false;
        allow update: if puedeLeer(resource.data) && noMueveCentro()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['estado', 'estadoActualizadoAt', 'estadoActualizadoBy'])
                      && request.resource.data.estado in ['pendiente', 'aceptado', 'rechazado']
                      // Un presupuesto con pagos registrados ya no puede salir de 'aceptado'.
                      && (!('pagado' in resource.data) || resource.data.pagado <= 0
                          || request.resource.data.estado == 'aceptado');
      }
    }

    // ---------- Agenda compartida del centro ----------
    // "Todos pueden todo" dentro del centro: puedeLeer no compara uid, así que
    // cualquier profesional edita o cancela la cita de un colega. El aislamiento
    // sigue siendo por centroId, igual que patients.
    match /appointments/{appointmentId} {
      allow read:   if puedeLeerRecurso(resource);
      allow create: if centroValido(request.resource.data);
      allow update: if puedeLeer(resource.data) && noMueveCentro();
      // Cancelar es un cambio de estado, no un delete: el borrado real queda
      // solo para admin para no perder el historial de la agenda.
      allow delete: if esAdmin();
    }

    // Collection group: el doctor DEBE incluir where('centroId','==',X)
    match /{path=**}/visits/{visitId}   { allow read: if puedeLeerRecurso(resource); }
    match /{path=**}/prescriptions/{id} { allow read: if puedeLeerRecurso(resource); }
    match /{path=**}/certificates/{id}  { allow read: if puedeLeerRecurso(resource); }
    match /{path=**}/attachments/{id}   { allow read: if puedeLeerRecurso(resource); }
    match /{path=**}/budgets/{id}       { allow read: if puedeLeerRecurso(resource); }
    match /{path=**}/payments/{id}      { allow read: if puedeLeerRecurso(resource); }

    match /{document=**} { allow read, write: if false; }
  }
}
