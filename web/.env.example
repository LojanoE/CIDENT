# Copiar a .env.local (nunca commitear .env* salvo este ejemplo) y completar
# con la configuración del proyecto Firebase (Consola → Configuración del
# proyecto → General → "Tus apps" → app web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para conectar el SDK a los emuladores locales
# (firebase emulators:start) en vez del proyecto real.
VITE_USE_EMULATORS=true
